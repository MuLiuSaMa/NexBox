Windows Registry Editor Version 5.00

; 禁用 NVIDIA 遥测数据收集
; 阻止 GeForce Experience 和驱动发送使用统计

[HKEY_LOCAL_MACHINE\SOFTWARE\NVIDIA Corporation\NvControlPanel2\Client]
"OptInOrOutPreference"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\NVIDIA Corporation\Global\FTS]
"EnableRID66610"=dword:00000000
"EnableRID64640"=dword:00000000
"EnableRID44231"=dword:00000000

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NvTelemetryContainer]
"Start"=dword:00000004
