{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UninstNexBox",
  "version": "9.0.0",
  "identifier": "com.nexbox.uninstaller",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "新境盒 卸载程序",
        "width": 580,
        "height": 460,
        "minWidth": 580,
        "minHeight": 460,
        "maxWidth": 580,
        "maxHeight": 460,
        "resizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
