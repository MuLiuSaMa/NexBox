{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NexBox",
  "version": "9.1.5",
  "identifier": "NexBox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "新境盒",
        "width": 1230,
        "height": 771,
        "minWidth": 1140,
        "minHeight": 715,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=MediaSessionService,HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      },
      {
        "title": "NexBox Tray Menu",
        "width": 190,
        "height": 140,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "maximizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "label": "tray-menu",
        "url": "/tray-menu",
        "additionalBrowserArgs": "--disable-features=MediaSessionService,HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      },
      {
        "title": "NexBox Desktop Lyrics",
        "width": 800,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "maximizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "label": "desktop-lyrics",
        "url": "/desktop-lyrics",
        "additionalBrowserArgs": "--disable-features=MediaSessionService,HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      },
      {
        "title": "Lyrics Unlock",
        "width": 48,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "maximizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "label": "lyrics-unlock-btn",
        "url": "/lyrics-unlock-btn",
        "additionalBrowserArgs": "--disable-features=MediaSessionService,HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "resources": [
      "../nvidiaProfileInspector.exe",
      "../nvidiaProfileInspector.exe.config",
      "../Reference.xml",
      "../power-plans/*",
      "../monitor/bin/Release/net48/*",
      "../aq_registry/*",
      "../aq_registry_restore/*",
      "resources/binaries/fxvad/*",
      "resources/binaries/fxvad/presets/*",
      "resources/binaries/PresentMon-2.5.1-x64.exe",
      "resources/binaries/icc-tools/*",
      "resources/binaries/PawnIO_setup.exe",
      "resources/crosshair-presets/*",
      "resources/icc-presets/*",
      "resources/vive/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
