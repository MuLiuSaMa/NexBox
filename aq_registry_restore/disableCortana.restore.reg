Windows Registry Editor Version 5.00

; 恢复 Cortana 与网络搜索为系统默认（删除所有策略值）

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\Windows Search]
"AllowCortana"=-
"DisableWebSearch"=-
"ConnectedSearchUseWeb"=-
"ConnectedSearchUseWebOverMeteredConnections"=-
"AllowCloudSearch"=-
"AllowCortanaAboveLock"=-
"AllowCortanaInAAD"=-
"AllowCortanaInAADPathOOBE"=-
"AllowSearchToUseLocation"=-
"ConnectedSearchPrivacy"=-

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\SearchSettings]
"IsDeviceSearchHistoryEnabled"=-

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search]
"HistoryViewEnabled"=-
"DeviceHistoryEnabled"=-
"AllowSearchToUseLocation"=-
"BingSearchEnabled"=-
"CortanaConsent"=-

[HKEY_CURRENT_USER\Software\Microsoft\Speech_OneCore\Preferences]
"VoiceActivationEnableAboveLockscreen"=-
